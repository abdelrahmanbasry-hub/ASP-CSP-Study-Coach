{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asp-csp-coach.local/schemas/practice-v2-question-pack.schema.json",
  "title": "ASP/CSP Coach Practice V2 Question Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "packStatus", "questions"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "packId": { "type": "string", "minLength": 1 },
    "packStatus": { "enum": ["demo", "content"] },
    "chapterId": { "type": "string", "minLength": 1 },
    "chapterTitle": { "type": "string", "minLength": 1 },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "groupedBlueprintMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprintVersion", "primaryObjectiveId", "secondaryObjectiveIds"],
      "properties": {
        "blueprintVersion": { "enum": ["ASP11", "CSP11"] },
        "primaryObjectiveId": { "type": "string", "minLength": 1 },
        "secondaryObjectiveIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "objectiveBlueprintMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "blueprintVersion", "objectiveId", "role"],
      "properties": {
        "credential": { "enum": ["ASP", "CSP"] },
        "blueprintVersion": { "enum": ["ASP11", "CSP11"] },
        "objectiveId": { "type": "string", "pattern": "^(ASP11-A[1-9]|CSP11-D[1-7])\\.[0-9]{2}[a-z]?$" },
        "role": { "enum": ["primary", "secondary"] }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "chapterId", "chapterTitle", "examAlignments", "blueprintMappings", "concept", "itemFamilyId", "questionType", "cognitiveLevel", "stem", "options", "correctOptionIndex", "correctAnswerExplanation", "incorrectOptionExplanations", "sourceTitle", "sourceLocation", "formula", "units", "reviewStatus", "verificationStatus", "authoringOrigin", "contentValidationStatus", "duplicateSimilarityCheckStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "chapterId": { "type": "string", "minLength": 1 },
        "chapterTitle": { "type": "string", "minLength": 1 },
        "examAlignments": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["ASP", "CSP"] } },
        "blueprintMappings": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "$ref": "#/$defs/groupedBlueprintMapping" }, { "$ref": "#/$defs/objectiveBlueprintMapping" }] } },
        "concept": { "type": "string", "minLength": 1 },
        "itemFamilyId": { "type": "string", "minLength": 1 },
        "questionType": { "enum": ["single-best-answer", "scenario", "calculation"] },
        "cognitiveLevel": { "enum": ["remember", "understand", "apply", "analyze", "evaluate"] },
        "stem": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "correctOptionIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
        "correctAnswerExplanation": { "type": "string", "minLength": 1 },
        "incorrectOptionExplanations": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/nullableString" } },
        "sourceTitle": { "$ref": "#/$defs/nullableString" },
        "sourceLocation": { "$ref": "#/$defs/nullableString" },
        "sourceUrls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "sourceVerifiedOn": { "type": "string", "format": "date" },
        "formula": { "$ref": "#/$defs/nullableString" },
        "units": { "$ref": "#/$defs/nullableString" },
        "reviewStatus": { "enum": ["demo", "draft", "ready", "rejected", "retired"] },
        "verificationStatus": { "enum": ["unverified", "source-checked", "human-reviewed"] },
        "authoringOrigin": { "enum": ["human-authored", "ai-assisted", "imported"] },
        "contentValidationStatus": { "enum": ["pending", "passed", "failed"] },
        "duplicateSimilarityCheckStatus": { "enum": ["pending", "passed", "failed"] },
        "contentFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        { "if": { "properties": { "questionType": { "const": "calculation" } } }, "then": { "properties": { "formula": { "type": "string", "minLength": 1 }, "units": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "verificationStatus": { "enum": ["source-checked", "human-reviewed"] } } }, "then": { "properties": { "reviewStatus": { "const": "ready" }, "sourceTitle": { "type": "string", "minLength": 1 }, "sourceLocation": { "type": "string", "minLength": 1, "pattern": "(?:[Cc]hapter|[Cc]h\\.?|[Pp]age|[Pp]{1,2}\\.?|[Ss]ection|[Ss]ec\\.?|[Rr]egulation|[Ss]tandard|CFR|cfr|§)" }, "contentValidationStatus": { "const": "passed" }, "duplicateSimilarityCheckStatus": { "const": "passed" } } } },
        { "if": { "properties": { "verificationStatus": { "const": "source-checked" } } }, "then": { "properties": { "authoringOrigin": { "const": "ai-assisted" } } } },
        { "if": { "properties": { "verificationStatus": { "const": "human-reviewed" } } }, "then": { "properties": { "authoringOrigin": { "const": "human-authored" } } } }
      ]
    }
  }
}
